{
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "extraKnownMarketplaces": {
    "claudepedro": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  },
  "enabledMcpjsonServers": [
    "music21",
    "philosophy"
  ],
  "enabledPlugins": {
    "superpowers@claudepedro": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
